<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.warehouse.dao.UserDao">
    <!--update user permission-->
    <update id="updateUserPermission">
        update user
        <set>
            <if test="userPermission !=null">
                user_permission=#{userPermission}
            </if>
        </set>
        where user_id=#{userID};
    </update>
    <!--change password-->
    <update id="updatePassword">
        UPDATE user
        SET password = #{password}
        WHERE user_id = #{userID}
    </update>

    <!-- DELETE USER-->
    <!-- Format: (id1,id2,id3,...)-->
    <delete id="deleteUser">
        delete
        from user
        where user_id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>
    <!--FIND USER-->
    <select id="list" resultType="com.warehouse.pojo.User">
        select * from user
        <where>
            <if test="userName != null">
                <if test="userID != null or userPermission != null">
                    AND
                </if>
                user_name like concat('%', #{userName}, '%')
            </if>
            <if test="userID != null">
                <if test="userName != null or userPermission != null">
                    AND
                </if>
                user_id = #{userID}
            </if>
            <if test="userPermission != null">
                <if test="userName != null or userID != null">
                    AND
                </if>
                user_permission = #{userPermission}
            </if>
        </where>
    </select>
    <!--find user by id ans and question-->
    <select id="getUserByIDAndQueAndAns" resultType="com.warehouse.pojo.User">
        SELECT * FROM user
        WHERE user_id = #{userID} AND security_answer = #{securityAnswer} AND security_question = #{securityQuestion}
    </select>


</mapper>